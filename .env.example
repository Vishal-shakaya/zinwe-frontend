# Base URL of the Zinwe Django API (no trailing slash).
#
# Local development: leave EMPTY. Requests go to /api/... on the Vite dev
# server, which proxies them to http://127.0.0.1:8000 (see vite.config.ts).
#
# Production: set to the public API origin, e.g.
#   VITE_API_BASE_URL=https://api.zinwe.io
# The backend must then allow this site's origin via CORS.
VITE_API_BASE_URL=

# Owner dashboard sample data (src/dashboard/fixtures, SAMPLES_ON).
# Features the API doesn't serve yet (Tasks, Reports -> Performance, the bell's
# history, a second PC per person, photos, some Rules and Settings rows) run on
# sample data. They always show in the dev server (npm run dev) and are hidden
# in every plain build (production). Set to 1 only for a demo/staging build
# that should show them.
VITE_SAMPLE_DATA=
