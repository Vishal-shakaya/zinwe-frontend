# Base URL of the Zinwe Django API (no trailing slash).
#
# Local development: leave EMPTY. Requests go to /api/... on the Vite dev
# server, which proxies them to http://127.0.0.1:8000 (see vite.config.ts).
#
# Production: set to the public API origin, e.g.
#   VITE_API_BASE_URL=https://api.zinwe.io
# The backend must then allow this site's origin via CORS.
VITE_API_BASE_URL=
